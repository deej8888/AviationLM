AEROLM_BACKEND=rules
AEROLM_MODEL_ID=Qwen/Qwen3-0.6B
# For reproducible model runs, set an immutable Hugging Face commit SHA.
AEROLM_MODEL_REVISION=main
AEROLM_ADAPTER_PATH=
AEROLM_DEVICE=cpu
# Explicit BF16 can speed up HF inference on supported recent CPUs.
AEROLM_PRECISION=auto
# AEROLM_CPU_THREADS=12
# Optional source-mention checks: warn (default) or reject unverified non-null facts.
AEROLM_EVIDENCE_POLICY=warn
# Optional HF baseline controls (install --extra structured for constrained generation).
# AEROLM_FEW_SHOT_PATH=data/charter_demonstrations.jsonl
AEROLM_STRUCTURED_OUTPUT=false
AEROLM_CORS_ORIGINS=["http://localhost:3000"]
# Optional bearer token for the API (set the same token in web/.env.local).
AEROLM_API_KEY=
# Server-side Next.js proxy configuration:
AEROLM_API_URL=http://127.0.0.1:8000
